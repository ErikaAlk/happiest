+  // React Native 的尺寸保留原单位；只有未指定的方向使用原生内容尺寸。
+  void setSizeFromContent(react::Size size) const {
+    this->ensureUnsealed();
+    auto const &props = *std::static_pointer_cast<const facebook::react::ViewProps>(
+      this->getProps());
+    auto style = this->yogaNode_.style();
+    auto width = props.yogaStyle.dimension(facebook::yoga::Dimension::Width);
+    auto height = props.yogaStyle.dimension(facebook::yoga::Dimension::Height);
+    if (!width.value().isDefined() && !std::isnan(size.width)) {
+      style.setDimension(facebook::yoga::Dimension::Width,
+                         facebook::yoga::StyleSizeLength::points(size.width));
+    }
+    if (!height.value().isDefined() && !std::isnan(size.height)) {
+      style.setDimension(facebook::yoga::Dimension::Height,
+                         facebook::yoga::StyleSizeLength::points(size.height));
+    }
+    this->yogaNode_.setStyle(style);
+    this->yogaNode_.setDirty(true);
+  }
