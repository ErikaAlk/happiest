{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Happiest",
  "version": "0.1.1",
  "identifier": "click.erikaalk.happiest",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:dev",
    "beforeBuildCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "default",
        "pet_overlay"
      ],
      "csp": null
    },
    "windows": [
      {
        "title": "Happiest",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#F5F5F5",
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "externalBin": [
      "binaries/hsetup"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/AppIcon.icon",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "./dmg/dmg-background.png",
        "windowSize": {
          "width": 840,
          "height": 560
        },
        "appPosition": {
          "x": 290,
          "y": 274
        },
        "applicationFolderPosition": {
          "x": 546,
          "y": 272
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQUJEM0U2OTFFMkZFOTAKUldTUS91S1I1dE9yejh0VmdDcmJvekM4cGFLTUo5VkxSQTJrTWNiNDkxYlpzVlYvR2VFbzNhRGwK",
      "endpoints": [
        "https://github.com/ErikaAlk/happiest/releases/download/ui-desktop-stable/latest.json"
      ]
    }
  }
}
